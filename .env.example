# Non-secret example only. Use the local LLM configuration tool to create .env.local.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.invalid/v1
LLM_MODEL=example-model
UKA_USE_LLM=auto
UKA_STATE_DIR=.uka-state
UKA_LLM_TIMEOUT_SECONDS=120
UKA_CLUSTERING_ENABLED=true
UKA_CLUSTER_AUTO_EVERY=12
UKA_CLUSTER_BATCH_SIZE=24
